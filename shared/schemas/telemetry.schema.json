{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MERIDIAN live telemetry",
  "type": "object",
  "required": ["timestamp_s", "mode", "position", "motion", "gnss", "metrics"],
  "properties": {
    "timestamp_s": {"type": "number"},
    "mode": {"enum": ["acquiring_gnss", "gnss_aided_ins", "dead_reckoning", "reacquiring"]},
    "position": {
      "type": "object",
      "required": ["latitude_deg", "longitude_deg", "east_m", "north_m", "heading_deg"],
      "properties": {
        "latitude_deg": {"type": ["number", "null"]},
        "longitude_deg": {"type": ["number", "null"]},
        "east_m": {"type": ["number", "null"]},
        "north_m": {"type": ["number", "null"]},
        "heading_deg": {"type": "number"},
        "reference_gnss": {"type": "object"},
        "last_accepted_gnss": {"type": "object"}
      }
    },
    "motion": {
      "type": "object",
      "required": ["speed_mps", "accelerometer_mps2", "gyroscope_rps", "magnetometer_ut"],
      "properties": {
        "speed_mps": {"type": "number"},
        "model_speed_mps": {"type": "number"},
        "velocity_model_trusted": {"type": "boolean"},
        "mount_calibrated": {"type": "boolean"},
        "mount_degraded": {"type": "boolean"},
        "motion_anomaly": {"type": "boolean"},
        "stationary": {"type": "boolean"},
        "vehicle_motion_armed": {"type": "boolean"},
        "accelerometer_mps2": {"$ref": "#/$defs/vector3"},
        "gyroscope_rps": {"$ref": "#/$defs/vector3"},
        "magnetometer_ut": {"$ref": "#/$defs/vector3"}
      }
    },
    "gnss": {
      "type": "object",
      "required": ["available", "latitude_deg", "longitude_deg", "accuracy_m"],
      "properties": {
        "available": {"type": "boolean"},
        "aiding_enabled": {"type": "boolean"},
        "degraded": {"type": "boolean"},
        "latitude_deg": {"type": ["number", "null"]},
        "longitude_deg": {"type": ["number", "null"]},
        "accuracy_m": {"type": ["number", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["position_error_m", "drift_percent", "dr_distance_m", "seconds_since_gnss"],
      "properties": {
        "position_error_m": {"type": ["number", "null"]},
        "drift_percent": {"type": ["number", "null"]},
        "dr_distance_m": {"type": "number"},
        "seconds_since_gnss": {"type": "number"},
        "prediction_confidence": {"type": ["number", "null"]},
        "prediction_confidence_reason": {"type": "string"}
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    }
  }
}
