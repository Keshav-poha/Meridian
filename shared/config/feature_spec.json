{
  "contract_version": "0.2.0",
  "coordinate_frames": {
    "phone_body": "x_right_y_up_z_screen_normal",
    "vehicle": "x_forward_y_right_z_down",
    "navigation": "local_enu_meters"
  },
  "time": {
    "timestamp_field": "timestamp_s",
    "window_seconds": 2.0,
    "sample_rate_hz": 10,
    "stride_samples": 2,
    "runtime_input_rate_hz": {
      "mobile": 100,
      "edge": 200
    }
  },
  "input_channels": [
    "linear_accel_forward_mps2",
    "linear_accel_right_mps2",
    "linear_accel_down_mps2",
    "gyro_forward_rps",
    "gyro_right_rps",
    "gyro_down_rps",
    "mag_forward_unit",
    "mag_right_unit",
    "mag_down_unit"
  ],
  "derived_features": [
    "gravity_compensated_acceleration",
    "body_to_vehicle_mount_rotation",
    "magnetic_direction_normalization",
    "complementary_attitude_filter"
  ],
  "labels": [
    "forward_speed_mps",
    "heading_rad",
    "position_east_m",
    "position_north_m"
  ],
  "normalization": {
    "method": "training_split_zscore",
    "epsilon": 1e-06
  }
}
